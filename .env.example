# Copia este archivo como ".env" para trabajar en local.
# En Azure NO se sube el .env: estas mismas variables se crean en
# App Service > Configuración > Variables de entorno.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/undercaps?retryWrites=true&w=majority&appName=Cluster0

# Clave secreta para firmar las sesiones (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# Cuenta de administrador que se crea automáticamente al iniciar
ADMIN_EMAIL=admin@undercaps.com
ADMIN_PASSWORD=CAMBIA_POR_UNA_CLAVE_UNICA_Y_SEGURA

# Puerto local (Azure asigna el suyo automáticamente)
PORT=3000
